NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
# Set these before creating a new database. Existing accounts are preserved.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Payments use hosted Paystack checkout and a signed webhook.
PAYSTACK_SECRET_KEY=
# Preview is available in development; this enables it in a production build for review.
ENABLE_PREVIEW=false

# Review-only serverless demo: encrypted, temporary browser state; no real investor data.
DEMO_MODE=false
